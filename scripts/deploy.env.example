# -------------------------------------------------------------------
# Deployment Environment Configuration Template
# -------------------------------------------------------------------
# Copy this file to 'deploy.env' and configure the parameters
# for the target staging or production environment.
# DO NOT commit 'deploy.env' to version control.

# The hostname or IP address of the target server
STAGING_HOST="staging.example.com"

# The SSH user to connect as
STAGING_USER="deployer"

# The absolute path on the remote server where the application is hosted
STAGING_PATH="/var/www/potensidesa"

# The git branch to deploy (e.g., main, staging)
DEPLOY_BRANCH="main"

# The base URL of the API to verify the deployment (without trailing slash)
API_BASE_URL="https://staging.example.com/api/v1"
